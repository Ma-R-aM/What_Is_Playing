<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and above.
   The Discord token is intentionally not backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="whatisplaying_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="whatisplaying_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
